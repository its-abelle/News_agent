# Export these variables in your shell; the CLI does not automatically load .env.
QWEN_API_KEY=
# DASHSCOPE_API_KEY is also accepted; QWEN_API_KEY takes precedence.
QWEN_MODEL=qwen-plus
# Singapore default. Use the compatible-mode base URL from your Model Studio
# console for your key's region/workspace (do not append /chat/completions).
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
TAVILY_API_KEY=
DELUXE_HOME=.deluxe
